# Leave VITE_API_URL empty to run the site with built-in demo data (this is what Bolt.new uses).
# Bookings are then saved only in the visitor's browser (localStorage), not sent to any server.
#
# To use the real Laravel backend:
#   local dev:   VITE_API_URL=/api            (Vite proxies /api to http://127.0.0.1:8000)
#   deployed:    VITE_API_URL=https://your-laravel-host.com/api
VITE_API_URL=
